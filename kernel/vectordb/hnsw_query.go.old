package vectordb

// =========================================
// HNSW 查询
// =========================================

// SearchResult 搜索结果
type SearchResult struct {
	ID       string                 `json:"id"`
	Score    float32                `json:"score"`    // 相似度分数 (1 - distance)
	Distance float32                `json:"distance"` // 距离
	Meta     map[string]interface{} `json:"meta"`     // 元数据
}

// Search 搜索最近邻
func (c *Collection) Search(queryVector []float32, modelName string, k int, efSearch int) []SearchResult {
	if efSearch <= 0 {
		efSearch = c.Config.EfSearch
	}
	if efSearch < k {
		efSearch = k
	}
	
	// 选择入口点
	entryPoint := 选择入口点(c, modelName, nil)
	if entryPoint == nil {
		return nil
	}
	
	// 执行搜索
	results := c.hnswSearch(queryVector, modelName, k, efSearch, entryPoint)
	return results
}

// hnswSearch 执行 HNSW 搜索
func (c *Collection) hnswSearch(queryVector []float32, modelName string, k int, efSearch int, entryPoint *Item) []SearchResult {
	// 获取入口点层级
	entryLevel := 获取数据项所在层级(entryPoint, modelName)
	if entryLevel < 0 {
		return nil
	}
	
	// 贪心下降到 0 层
	current := entryPoint
	for level := entryLevel; level > 0; level-- {
		current = c.greedySearchLevelQuery(queryVector, current, modelName, level)
	}
	
	// 在 0 层进行完整搜索
	results := c.searchLayer0(queryVector, current, modelName, efSearch)
	
	// 取前 k 个结果
	if len(results) > k {
		results = results[:k]
	}
	
	// 转换为 SearchResult
	searchResults := make([]SearchResult, 0, len(results))
	for _, r := range results {
		item := r.Data
		searchResults = append(searchResults, SearchResult{
			ID:       r.ID,
			Score:    1 - r.Distance, // 余弦相似度 = 1 - 余弦距离
			Distance: r.Distance,
			Meta:     item.Meta,
		})
	}
	
	return searchResults
}

// greedySearchLevelQuery 贪心搜索（查询版）
func (c *Collection) greedySearchLevelQuery(queryVector []float32, entry *Item, modelName string, level int) *Item {
	entryVec, ok := entry.GetVector(modelName)
	if !ok {
		return entry
	}
	
	current := entry
	currentDistance := CosineDistance(queryVector, entryVec)
	visited := make(map[string]bool)
	
	improved := true
	for improved {
		improved = false
		
		neighbors := 获取层级邻居(current, modelName, level)
		if neighbors == nil {
			break
		}
		
		for _, neighbor := range neighbors {
			if visited[neighbor.ID] {
				continue
			}
			visited[neighbor.ID] = true
			
			neighborItem, ok := c.GetItem(neighbor.ID)
			if !ok {
				continue
			}
			
			neighborVec, ok := neighborItem.GetVector(modelName)
			if !ok {
				continue
			}
			
			distance := CosineDistance(queryVector, neighborVec)
			if distance < currentDistance {
				current = neighborItem
				currentDistance = distance
				improved = true
				break
			}
		}
	}
	
	return current
}

// searchLayer0 在 0 层完整搜索
func (c *Collection) searchLayer0(queryVector []float32, entry *Item, modelName string, efSearch int) []*HeapItem {
	entryVec, ok := entry.GetVector(modelName)
	if !ok {
		return nil
	}
	
	entryDistance := CosineDistance(queryVector, entryVec)
	
	// 候选队列（最小堆）- 待检查的节点
	candidates := NewMinHeap()
	candidates.Push(&HeapItem{ID: entry.ID, Distance: entryDistance, Data: entry})
	
	// 结果队列（最大堆）- 当前最佳结果
	results := NewMaxHeap(efSearch)
	results.Push(&HeapItem{ID: entry.ID, Distance: entryDistance, Data: entry})
	
	visited := make(map[string]bool)
	visited[entry.ID] = true
	
	for !candidates.IsEmpty() {
		// 获取当前最优候选
		bestCandidate := candidates.Peek()
		farthestResult := results.Peek()
		
		// 剪枝条件：最优候选比结果中最差的还差，且结果已满
		if farthestResult != nil && bestCandidate.Distance > farthestResult.Distance && results.IsFull() {
			break
		}
		
		current := candidates.Pop()
		currentItem := current.Data
		
		// 遍历当前节点的邻居
		neighbors := 获取层级邻居(currentItem, modelName, 0)
		if neighbors == nil {
			continue
		}
		
		for _, neighbor := range neighbors {
			if visited[neighbor.ID] {
				continue
			}
			visited[neighbor.ID] = true
			
			neighborItem, ok := c.GetItem(neighbor.ID)
			if !ok {
				continue
			}
			
			neighborVec, ok := neighborItem.GetVector(modelName)
			if !ok {
				continue
			}
			
			distance := CosineDistance(queryVector, neighborVec)
			currentFarthest := results.Peek()
			
			// 如果比当前最差结果更好，或者结果未满，加入候选
			if currentFarthest == nil || !results.IsFull() || distance < currentFarthest.Distance {
				heapItem := &HeapItem{ID: neighbor.ID, Distance: distance, Data: neighborItem}
				candidates.Push(heapItem)
				
				if !results.IsFull() {
					results.Push(heapItem)
				} else {
					results.Replace(heapItem)
				}
			}
		}
	}
	
	return results.ToSortedArray()
}

// =========================================
// 多入口点搜索（提高召回率）
// =========================================

// SearchMultiEntry 多入口点搜索
func (c *Collection) SearchMultiEntry(queryVector []float32, modelName string, k int, efSearch int, maxRetries int) []SearchResult {
	if maxRetries <= 0 {
		maxRetries = 3
	}
	
	resultMap := make(map[string]*HeapItem)
	visitedEntries := make(map[string]bool)
	
	for i := 0; i < maxRetries && len(resultMap) < k; i++ {
		entryPoint := 选择入口点(c, modelName, visitedEntries)
		if entryPoint == nil {
			break
		}
		visitedEntries[entryPoint.ID] = true
		
		results := c.hnswSearch(queryVector, modelName, k, efSearch, entryPoint)
		for _, r := range results {
			if _, exists := resultMap[r.ID]; !exists {
				resultMap[r.ID] = &HeapItem{
					ID:       r.ID,
					Distance: r.Distance,
					Data:     nil, // 这里不需要完整数据
				}
			}
		}
	}
	
	// 转换并排序结果
	searchResults := make([]SearchResult, 0, len(resultMap))
	for id, h := range resultMap {
		item, ok := c.GetItem(id)
		if !ok {
			continue
		}
		searchResults = append(searchResults, SearchResult{
			ID:       id,
			Score:    1 - h.Distance,
			Distance: h.Distance,
			Meta:     item.Meta,
		})
	}
	
	// 按分数降序排序
	for i := 0; i < len(searchResults)-1; i++ {
		for j := i + 1; j < len(searchResults); j++ {
			if searchResults[j].Score > searchResults[i].Score {
				searchResults[i], searchResults[j] = searchResults[j], searchResults[i]
			}
		}
	}
	
	if len(searchResults) > k {
		searchResults = searchResults[:k]
	}
	
	return searchResults
}
