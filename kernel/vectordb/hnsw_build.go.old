// =========================================
// HNSW 索引构建
// =========================================

// InsertItem 插入数据项到 HNSW 索引
func (c *Collection) InsertItem(item *Item, modelName string) error {
	config := c.Config
	
	// 1. 初始化邻接表，确定层�?
	level := 初始化数据项邻接�?item, modelName, config.MaxLevel)
	
	// 2. 添加�?Collection
	c.SetItem(item)
	
	// 3. 更新层级映射
	c.Mu.Lock()
	添加节点到层级映�?c.HNSWLevelMap, modelName, item.ID, level)
	c.Mu.Unlock()
	
	// 4. 选择入口�?
	visited := make(map[string]bool)
	visited[item.ID] = true
	entryPoint := 选择入口�?c, modelName, visited)
	
	if entryPoint == nil {
		// 第一个节点，无需连接
		return nil
	}
	
	// 5. 从入口点开始构建索�?
	return c.buildHNSWIndex(item, modelName, entryPoint, level)
}

// buildHNSWIndex 构建 HNSW 索引
func (c *Collection) buildHNSWIndex(item *Item, modelName string, entryPoint *Item, targetLevel int) error {
	config := c.Config
	
	currentEntry := entryPoint
	entryLevel := 获取数据项所在层�?entryPoint, modelName)
	
	// 从入口点层级向下贪心搜索到目标层�?
	for level := entryLevel; level > targetLevel; level-- {
		result := c.greedySearchLevel(item, currentEntry, modelName, level)
		if result != nil {
			currentEntry = result
		}
	}
	
	// 在每一层连接邻�?
	for level := min(targetLevel, entryLevel); level >= 0; level-- {
		// 搜索候选邻�?
		candidates := c.searchLayerCandidates(item, currentEntry, modelName, level, config.EfConstruction)
		
		// 启发式选择最终邻�?
		maxNeighbors := 计算层级预期邻居数量(level, config.M)
		selectedNeighbors := c.selectNeighborsByHeuristic(item, candidates, modelName, maxNeighbors)
		
		// 链接邻居
		nextEntry := c.linkNeighbors(item, selectedNeighbors, modelName, level)
		if nextEntry != nil {
			currentEntry = nextEntry
		}
	}
	
	return nil
}

// greedySearchLevel 贪心搜索当前层级
func (c *Collection) greedySearchLevel(target *Item, entry *Item, modelName string, level int) *Item {
	config := c.Config
	
	current := entry
	currentVec, ok := target.GetVector(modelName)
	if !ok {
		return entry
	}
	
	currentEntryVec, ok := current.GetVector(modelName)
	if !ok {
		return entry
	}
	
	currentDistance := CosineDistance(currentVec, currentEntryVec)
	visited := make(map[string]bool)
	visited[target.ID] = true
	
	improved := true
	for improved {
		improved = false
		
		neighbors := 获取层级邻居(current, modelName, level)
		if neighbors == nil {
			break
		}
		
		for _, neighbor := range neighbors {
			if visited[neighbor.ID] {
				continue
			}
			visited[neighbor.ID] = true
			
			neighborItem, ok := c.GetItem(neighbor.ID)
			if !ok {
				continue
			}
			
			neighborVec, ok := neighborItem.GetVector(modelName)
			if !ok {
				continue
			}
			
			distance := CosineDistance(currentVec, neighborVec)
			if distance < currentDistance {
				current = neighborItem
				currentDistance = distance
				improved = true
				break
			}
		}
	}
	
	if config.MetricType == "l2" {
		// L2 距离版本
		// ... 类似逻辑
	}
	
	return current
}

// searchLayerCandidates 搜索当前层级的候选邻�?
func (c *Collection) searchLayerCandidates(target *Item, entry *Item, modelName string, level int, ef int) []*HeapItem {
	config := c.Config
	
	targetVec, ok := target.GetVector(modelName)
	if !ok {
		return nil
	}
	
	entryVec, ok := entry.GetVector(modelName)
	if !ok {
		return nil
	}
	
	entryDistance := CosineDistance(targetVec, entryVec)
	
	// 候选队列（最小堆�?
	candidates := NewMinHeap()
	candidates.Push(&HeapItem{ID: entry.ID, Distance: entryDistance, Data: entry})
	
	// 结果队列（最大堆，容量限�?ef�?
	results := NewMaxHeap(ef)
	results.Push(&HeapItem{ID: entry.ID, Distance: entryDistance, Data: entry})
	
	visited := make(map[string]bool)
	visited[target.ID] = true
	visited[entry.ID] = true
	
	for !candidates.IsEmpty() {
		bestCandidate := candidates.Peek()
		farthestResult := results.Peek()
		
		// 剪枝：如果最佳候选已经比结果中最远的还远，且结果已满
		if farthestResult != nil && bestCandidate.Distance > farthestResult.Distance && results.IsFull() {
			break
		}
		
		current := candidates.Pop()
		currentItem := current.Data
		
		neighbors := 获取层级邻居(currentItem, modelName, level)
		if neighbors == nil {
			continue
		}
		
		for _, neighbor := range neighbors {
			if visited[neighbor.ID] {
				continue
			}
			visited[neighbor.ID] = true
			
			neighborItem, ok := c.GetItem(neighbor.ID)
			if !ok {
				continue
			}
			
			neighborVec, ok := neighborItem.GetVector(modelName)
			if !ok {
				continue
			}
			
			distance := CosineDistance(targetVec, neighborVec)
			currentFarthest := results.Peek()
			
			if currentFarthest == nil || !results.IsFull() || distance < currentFarthest.Distance {
				heapItem := &HeapItem{ID: neighbor.ID, Distance: distance, Data: neighborItem}
				candidates.Push(heapItem)
				
				if !results.IsFull() {
					results.Push(heapItem)
				} else {
					results.Replace(heapItem)
				}
			}
		}
	}
	
	if config.MetricType == "l2" {
		// L2 距离版本 - 类似逻辑
	}
	
	return results.ToSortedArray()
}

// selectNeighborsByHeuristic 启发式选择邻居
// 保证图的多样性，避免陷入局部最�?
func (c *Collection) selectNeighborsByHeuristic(target *Item, candidates []*HeapItem, modelName string, maxNeighbors int) []*HeapItem {
	if len(candidates) <= maxNeighbors {
		return candidates
	}
	
	config := c.Config
	result := make([]*HeapItem, 0, maxNeighbors)
	
	for _, candidate := range candidates {
		if len(result) >= maxNeighbors {
			break
		}
		
		// 检查是否与已选邻居形成更优的三角关系
		good := true
		for _, selected := range result {
			// 如果候选到已选邻居的距离 < 候选到目标的距�?
			// 说明已选邻居能更好地代表这个方向，跳过
			distToSelected := c.computeDistance(candidate.Data, selected.Data, modelName, config.MetricType)
			if distToSelected < candidate.Distance {
				good = false
				break
			}
		}
		
		if good {
			result = append(result, candidate)
		}
	}
	
	return result
}

// linkNeighbors 链接邻居（双向）
func (c *Collection) linkNeighbors(item *Item, neighbors []*HeapItem, modelName string, level int) *Item {
	config := c.Config
	maxNeighbors := 计算层级预期邻居数量(level, config.M)
	
	// 设置自己的邻�?
	neighborRecords := make([]NeighborRecord, 0, len(neighbors))
	for _, n := range neighbors {
		neighborRecords = append(neighborRecords, NeighborRecord{
			ID:       n.ID,
			Distance: n.Distance,
		})
	}
	设置层级邻居(item, modelName, level, neighborRecords)
	
	var closestNeighbor *Item
	var closestDistance float32 = 2.0
	
	// 反向链接：将自己添加到邻居的邻接�?
	for _, neighbor := range neighbors {
		neighborItem := neighbor.Data
		if neighborItem.ID == item.ID {
			continue
		}
		
		// 添加到邻居的邻接�?
		添加邻居(neighborItem, modelName, level, NeighborRecord{
			ID:       item.ID,
			Distance: neighbor.Distance,
		})
		
		// 检查邻居的邻接表是否超�?
		neighborNeighbors := 获取层级邻居(neighborItem, modelName, level)
		if len(neighborNeighbors) > maxNeighbors {
			// 需要修剪：保留距离最近的 maxNeighbors �?
			c.pruneNeighbors(neighborItem, modelName, level, maxNeighbors)
		}
		
		// 记录最近邻�?
		if neighbor.Distance < closestDistance {
			closestDistance = neighbor.Distance
			closestNeighbor = neighborItem
		}
	}
	
	return closestNeighbor
}

// pruneNeighbors 修剪邻居列表
func (c *Collection) pruneNeighbors(item *Item, modelName string, level int, maxNeighbors int) {
	neighbors := 获取层级邻居(item, modelName, level)
	if len(neighbors) <= maxNeighbors {
		return
	}
	
	// 使用最大堆选出最近的 maxNeighbors �?
	heap := NewMaxHeap(maxNeighbors)
	for _, n := range neighbors {
		heapItem := &HeapItem{ID: n.ID, Distance: n.Distance}
		if !heap.IsFull() {
			heap.Push(heapItem)
		} else if n.Distance < heap.Peek().Distance {
			heap.Replace(heapItem)
		}
	}
	
	// 转换回邻居记�?
	newNeighbors := make([]NeighborRecord, 0, maxNeighbors)
	sorted := heap.ToSortedArray()
	for _, h := range sorted {
		newNeighbors = append(newNeighbors, NeighborRecord{
			ID:       h.ID,
			Distance: h.Distance,
		})
	}
	
	设置层级邻居(item, modelName, level, newNeighbors)
}

// computeDistance 计算两个数据项的距离
func (c *Collection) computeDistance(a, b *Item, modelName string, metricType string) float32 {
	return ComputeItemDistance(a, b, modelName, metricType)
}

// min 返回较小�?
func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}
