{
  "name": "s-forge",
  "desktopName": "org.b3log.sforge",
  "version": "3.8.2-alpha.2",
  "description": "From thought to insight, with agents",
  "homepage": "https://b3log.org/siyuan",
  "main": "./electron/main.js",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "lint": "pnpm run typecheck && eslint . --fix --cache",
    "typecheck": "vue-tsc -p tsconfig.typecheck.json --noEmit",
    "lint:report": "eslint . --fix --cache --no-color --output-file lint-report.txt",
    "lint:file": "node ./scripts/check-file-lint.js",
    "lint:top": "node ./scripts/lint-top-errors.js",
    "lint:rules": "node ./scripts/lint-rule-stats.js",
    "lint:imports-gateway": "node ./scripts/check-imports-gateway-usage.js",
    "lint:imports-gateway-hops": "node ./scripts/check-imports-gateway-hops.mjs",
    "lint:cycles": "node ./scripts/check-source-cycles.mjs",
    "forge": "node ./scripts/forge-start.js",
    "setup:forge-hooks": "node ./scripts/forge-commit-runtime-gate.js install",
    "test": "pnpm run test:node && pnpm run test:vitest",
    "test:node": "node scripts/run-node-tests.mjs",
    "test:vitest": "node scripts/run-vitest-tests.mjs",
    "test:integration": "vitest --run --config vitest.integration.config.ts && node --import tsx --test test/forge-runtime-supervisor.integration.test.js",
    "dev": "webpack --mode development --no-cache",
    "dev:once": "webpack --mode development --no-cache --env oneShot=true",
    "dev:app": "webpack --mode development --env target=app",
    "dev:desktop": "webpack --mode development --env target=desktop",
    "dev:mobile": "webpack --mode development --env target=mobile",
    "dev:magi-app": "webpack --mode development --env target=magi-app",
    "dev:magi-desktop": "webpack --mode development --env target=magi-desktop",
    "dev:magi-mobile": "webpack --mode development --env target=magi-mobile",
    "dev:magi-identity": "webpack --mode development --env target=magi-identity",
    "dev:protyle-app": "webpack --mode development --no-cache --env target=protyle-app",
    "dev:agent-app": "webpack --mode development --no-cache --env target=agent-app",
    "dev:export": "webpack --mode development --env target=export",
    "build": "webpack --mode production",
    "build:app": "webpack --mode production --env target=app",
    "build:desktop": "webpack --mode production --env target=desktop",
    "build:mobile": "webpack --mode production --env target=mobile",
    "build:magi-app": "webpack --mode production --env target=magi-app",
    "build:magi-desktop": "webpack --mode production --env target=magi-desktop",
    "build:magi-mobile": "webpack --mode production --env target=magi-mobile",
    "build:magi-identity": "webpack --mode production --env target=magi-identity",
    "build:protyle-app": "webpack --mode production --env target=protyle-app",
    "build:agent-app": "webpack --mode production --env target=agent-app",
    "build:export": "webpack --mode production --env target=export",
    "gen:types": "tsc -d",
    "start": "cross-env NODE_ENV=development electron ./electron/main.js",
    "start:simulate-rosetta": "cross-env NODE_ENV=development electron ./electron/main.js --simulate-rosetta",
    "install:electron": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js",
    "sign:dev": "node scripts/signDevElectron.js",
    "dist": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.yml --publish=never",
    "dist-arm64": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --config electron-builder-arm64.yml --publish=never",
    "dist-darwin": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac --config electron-builder-darwin.yml --publish=never",
    "dist-darwin-arm64": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --mac --config electron-builder-darwin-arm64.yml --publish=never",
    "dist-linux": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux --config electron-builder-linux.yml --publish=never",
    "dist-linux-arm64": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --linux --config electron-builder-linux-arm64.yml --publish=never",
    "make:installer": "node ../build.js",
    "test:browser": "pnpm run build:protyle-app && pnpm run build:agent-app && vitest --run --config vitest.browser.config.ts",
    "test:agent-panel": "vitest --run test/layout/dock/agent test/magi",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck:protyle-contract": "tsc -p tsconfig.protyle-contract.json --pretty false",
    "typecheck:calibur-portable-declarations": "tsc -p tsconfig.calibur-portable-declarations.json --pretty false",
    "longest": "node ./scripts/checker/findLongestFile.js",
    "scan:oversized": "node ./scripts/checker/scanOversizedFiles.js",
    "scan:types:low-usage": "node ./scripts/checker/scanLowUsageTypes.js",
    "scan:unused:frontend": "node ./scripts/checker/scanUnusedFrontend.js",
    "scan:unused:frontend:strict": "node ./scripts/checker/scanUnusedFrontend.js --strict",
    "scan:unused:exports": "node ./scripts/checker/scanUnusedExports.js",
    "scan:unused:exports:strict": "node ./scripts/checker/scanUnusedExports.js --strict",
    "genI18nTypes": "node ./scripts/i18n.generateTypes.js",
    "genI18nTypes:en": "node ./scripts/i18n.generateTypes.js -l en_US -i ./appearance/langs/en_US.json -o ./src/types/i18n.types.ts",
    "genI18nTypes:zh_CN": "node ./scripts/i18n.generateTypes.js -l zh_CN -i ./appearance/langs/zh_CN.json -o ./src/types/i18n.types.ts",
    "genI18nTypes:zh_TW": "node ./scripts/i18n.generateTypes.js -l zh_TW -i ./appearance/langs/zh_CHT.json -o ./src/types/i18n.types.ts",
    "genI18nTypes:ja": "node ./scripts/i18n.generateTypes.js -l ja_JP -i ./appearance/langs/ja_JP.json -o ./src/types/i18n.types.ts",
    "genForgeI18nTypes": "node ./scripts/forgeI18n.generateTypes.js",
    "check:siyuan-types": "node ./scripts/check-siyuan-types.mjs",
    "update:siyuan-types": "pnpm update --latest siyuan && pnpm run check:siyuan-types",
    "migrate:files": "node scripts/migrate-files.mjs",
    "verify:d5a-migration": "node scripts/verify-d5a-migration.mjs"
  },
  "keywords": [
    "markdown",
    "note-taking",
    "notebook"
  ],
  "author": {
    "name": "Yunnan Liandi Technology Co., Ltd.",
    "email": "845765@qq.com",
    "url": "https://ld246.com"
  },
  "maintainers": [
    {
      "name": "Liang Ding",
      "email": "845765@qq.com",
      "url": "https://ld246.com/member/88250"
    },
    {
      "name": "Liyuan Li",
      "email": "84588990@qq.com",
      "url": "https://ld246.com/member/Vanessa"
    }
  ],
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "@huggingface/transformers": "3.1.0",
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-document": "^3.24.0",
    "@tiptap/extension-hard-break": "^3.24.0",
    "@tiptap/extension-history": "^3.24.0",
    "@tiptap/extension-mention": "^3.24.0",
    "@tiptap/extension-paragraph": "^3.24.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-text": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/suggestion": "^3.24.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.19",
    "@types/zxcvbn": "4.4.5",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "4.1.9",
    "@vue/compiler-sfc": "^3.5.22",
    "blueimp-md5": "^2.19.0",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "dayjs": "^1.11.5",
    "electron": "42.9.2",
    "electron-builder": "26.15.7",
    "encoding": "^0.1.13",
    "esbuild-loader": "^3.0.1",
    "eslint": "^9.15.0",
    "file-loader": "^6.2.0",
    "filesize": "^11.0.13",
    "globals": "^15.12.0",
    "happy-dom": "^20.11.1",
    "html-loader": "^2.1.2",
    "html-webpack-plugin": "^5.5.0",
    "iconv-lite": "^0.6.3",
    "ifdef-loader": "^2.3.2",
    "madge": "^8.0.0",
    "mini-css-extract-plugin": "2.9.2",
    "monaco-editor": "0.48.0",
    "path-browserify": "^1.0.1",
    "pinyin-pro": "^3.27.0",
    "playwright": "1.61.1",
    "safer-buffer": "^2.1.2",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "sharp": "^0.35.3",
    "siyuan": "latest",
    "ts-jest": "^29.4.5",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "unzipper": "0.12.5",
    "vitest": "^4.0.6",
    "vue": "^3.5.22",
    "vue-eslint-parser": "^10.2.0",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.3",
    "vue-tsc": "3.3.8",
    "webpack": "^5.104.1",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@leolee9086/everything-client-http": "link:../packages/everything-client-http",
    "@leolee9086/image-dehazing": "link:../packages/dehaze/",
    "@leolee9086/siyuan-kernel-sdk": "link:../kernelSDKTS",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@types/filesize": "^5.0.2",
    "arktype": "2.2.3",
    "calibur-router": "link:../packages/caliburRouter",
    "diff": "^8.0.3",
    "es-module-lexer": "^1.7.0",
    "eslint-plugin-vue": "^10.6.2",
    "magic-string": "^0.30.21",
    "path-to-regexp": "^6.3.0",
    "rbush": "^4.0.1",
    "url": "^0.11.4",
    "zod": "^4.1.12",
    "zxcvbn": "4.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
