{
  "name": "calibur-router",
  "version": "0.1.0",
  "description": "基于集合论的类型安全模式匹配引擎",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./arktype": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.contracts.json",
    "typecheck:performance": "tsc -p tsconfig.performance.json --extendedDiagnostics",
    "typecheck:performance:zod": "tsc -p tsconfig.performance.zod.json --extendedDiagnostics",
    "typecheck:performance:effect": "tsc -p tsconfig.performance.effect.json --extendedDiagnostics"
  },
  "dependencies": {
    "arktype": "^2.1.0"
  },
  "peerDependencies": {
    "effect": "^3.22.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "effect": "^3.22.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "router",
    "pattern-matching",
    "type-safe",
    "set-theory"
  ],
  "license": "MIT"
}
